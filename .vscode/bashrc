if [[ -f "${HOME}/.bashrc" ]]; then
  source "${HOME}/.bashrc"
fi

HISTFILE="${BASH_SOURCE[0]%/*}/terminal-history"
HISTSIZE=10000
HISTFILESIZE=10000

case ":${HISTCONTROL-}:" in
  *:ignorespace:*) ;;
  *) HISTCONTROL="${HISTCONTROL:+${HISTCONTROL}:}ignorespace" ;;
esac

shopt -s histappend

if [[ ! -e "$HISTFILE" ]]; then
  (umask 077 && : >> "$HISTFILE")
fi

PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
